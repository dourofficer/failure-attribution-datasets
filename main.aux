\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:timeline}{{1}{2}{Release timeline (month of the first arXiv version, approximate). Failure-attribution datasets appeared only after Who\&When (May 2025) and accelerated in 2026, moving from a few hundred hand-labelled logs to $10^4$ injected failures and to long-horizon, full-trace settings}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Overview. ``\#failed'' = labelled failed trajectories available (paper figure where the release differs; see each section). ``med.\ steps'' computed from the downloaded data. $^\dagger $MemTrace steps are memory operations in the dependency slice of the failed answer. $^\ddagger $Failure-as-a-Process: all 1\,794 runs, from the released annotations (trajectory text not released).}}{2}{table.caption.7}\protected@file@percent }
\newlabel{tab:overview}{{1}{2}{Overview. ``\#failed'' = labelled failed trajectories available (paper figure where the release differs; see each section). ``med.\ steps'' computed from the downloaded data. $^\dagger $MemTrace steps are memory operations in the dependency slice of the failed answer. $^\ddagger $Failure-as-a-Process: all 1\,794 runs, from the released annotations (trajectory text not released)}{table.caption.7}{}}
