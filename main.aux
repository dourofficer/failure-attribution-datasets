\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Labelled failed trajectories per dataset (log scale). Injected-fault datasets (orange) are 1--2 orders of magnitude larger than human-labelled natural ones (blue).}}{3}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sizes}{{2}{3}{Labelled failed trajectories per dataset (log scale). Injected-fault datasets (orange) are 1--2 orders of magnitude larger than human-labelled natural ones (blue)}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Steps per trajectory, computed from the downloaded data. Most benchmarks live in the 5--30 step range; LongRCA and MemTrace are the long-horizon outliers.}}{3}{figure.caption.8}\protected@file@percent }
\newlabel{fig:steps}{{3}{3}{Steps per trajectory, computed from the downloaded data. Most benchmarks live in the 5--30 step range; LongRCA and MemTrace are the long-horizon outliers}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Where the labelled error step sits inside the trajectory (relative position $t^\star /T$, 10 bins). Natural-failure benchmarks spread errors across the whole run with a spike at the end (the final wrong answer is often the labelled step); some injected datasets inject preferentially at the start (TracerTraj) or at the very end (Who\&When Pro, CORRECT-Error) --- a distribution shift to keep in mind when training on them.}}{3}{figure.caption.9}\protected@file@percent }
\newlabel{fig:errpos}{{4}{3}{Where the labelled error step sits inside the trajectory (relative position $t^\star /T$, 10 bins). Natural-failure benchmarks spread errors across the whole run with a spike at the end (the final wrong answer is often the labelled step); some injected datasets inject preferentially at the start (TracerTraj) or at the very end (Who\&When Pro, CORRECT-Error) --- a distribution shift to keep in mind when training on them}{figure.caption.9}{}}
